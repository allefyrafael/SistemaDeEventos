# ============================================
# Database (Postgres)
# ============================================
DATABASE_URL="postgresql://eventpass:eventpass_dev_password@localhost:5432/eventpass?schema=public"

# ============================================
# Redis (cache, rate-limit, jti blacklist, BullMQ)
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# Auth / JWT
# ============================================
# Use 32+ chars aleatorios em producao. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="dev-only-change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="dev-only-change-me-refresh-secret-min-32-chars"
JWT_QR_SECRET="dev-only-change-me-qr-code-secret-rotates-often"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
JWT_QR_TTL="30s"

# ============================================
# App
# ============================================
NODE_ENV="development"
API_PORT=3001
WEB_PORT=3000
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# ============================================
# Storage (S3-compatible: MinIO local ou AWS S3 / R2 em producao)
# ============================================
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="eventpass"
S3_REGION="us-east-1"

# ============================================
# Observabilidade (opcional em dev)
# ============================================
SENTRY_DSN=""
LOG_LEVEL="debug"
